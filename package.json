{
  "name": "vishu-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "VISHU independent desktop AI assistant",
  "productName": "VISHU",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:desktop\"",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:desktop": "wait-on http://127.0.0.1:5173 && electron .",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "package:backend": "python -m PyInstaller --noconfirm --clean --onefile --collect-all vosk --name VISHUBackend --paths backend --distpath release/backend --workpath release/pyinstaller/work --specpath release/pyinstaller backend/entrypoint.py",
    "dist:win": "npm run build && npm run package:backend && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.vishu.desktop",
    "productName": "VISHU",
    "asar": true,
    "directories": {
      "output": "release/installers"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "release/backend/VISHUBackend.exe",
        "to": "backend/VISHUBackend.exe"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "VISHU-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VISHU"
    }
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "electron-winstaller": true
  }
}
